{
  "name": "nextjs-base",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "bootstrap": "yarn --fronzen-lockfile",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "prettier": "prettier --check  \"./**/*.{js,jsx,ts,tsx,json}\"",
    "prettier:fix": "prettier --write  \"./**/*.{js,jsx,ts,tsx,json}\"",
    "check-types": "tsc --pretty --noEmit",
    "icon:generate": "node --env-file=.env.example scripts/generate-icon/index.js",
    "icon:previewer:generate": "node --env-file=.env.example scripts/generate-icon/generate-gallery.js && eslint --fix ./app/icon-gallery/page.tsx",
    "style:generate": "cross-env figma-export use-config scripts/generate-styles/.figmaexportrc.styles.js",
    "i18n:check": "i18n-check --source vi --locales app/i18n/translations -f i18next",
    "api:generate": "node --env-file=.env.example scripts/api/index.js && yarn prettier:fix",
    "route:generate": "node scripts/route/generate.mjs",
    "prepare": "husky install"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.90.20",
    "antd": "^6.2.1",
    "axios": "^1.13.2",
    "clsx": "^2.1.1",
    "cookies-next": "^6.1.1",
    "dayjs": "^1.11.19",
    "firebase": "^12.8.0",
    "i18next": "^25.8.4",
    "next": "16.1.4",
    "next-intl": "^4.7.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-error-boundary": "^6.1.0",
    "react-hook-form": "^7.71.1",
    "react-i18next": "15.5.3",
    "zod": "^4.3.6",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@figma-export/cli": "^6.3.0",
    "@figma-export/output-components-as-svgr": "^6.2.4",
    "@figma-export/output-styles-as-sass": "^6.2.4",
    "@figma-export/utils": "^6.1.0",
    "@lingual/i18n-check": "^0.8.19",
    "@svgr/plugin-jsx": "^8.1.0",
    "@svgr/plugin-prettier": "^8.1.0",
    "@svgr/plugin-svgo": "^8.1.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "3.8.0",
    "sass": "^1.97.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.53.1"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,scss}": "prettier --write"
  }
}
